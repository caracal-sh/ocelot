{
  "name": "@ocelot/editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "predev": "node scripts/vendor.mjs",
    "prebuild": "node scripts/vendor.mjs",
    "postbuild": "node scripts/engine-hash.mjs --write",
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "gen:bridge": "node ../scripts/gen-bridge.mjs",
    "gen:manifest": "node scripts/gen-tool-manifest.mjs",
    "e2e:perf": "node e2e/canvas-perf.mjs",
    "e2e:interleave": "node e2e/interleave.mjs",
    "e2e": "node e2e/canvas-perf.mjs && node e2e/interleave.mjs && node e2e/export-diff.mjs && node e2e/assets-e2e.mjs && node e2e/pages.mjs && node e2e/file-export.mjs",
    "e2e:export": "node e2e/export-diff.mjs",
    "e2e:assets": "node e2e/assets-e2e.mjs",
    "e2e:file-export": "node e2e/file-export.mjs",
    "e2e:timeline": "node e2e/timeline.mjs",
    "e2e:live-preview": "node e2e/live-preview.mjs",
    "e2e:deck-export": "node e2e/deck-export.mjs",
    "e2e:handoff": "node e2e/handoff.mjs",
    "ds:snapshot": "node scripts/ds-snapshot/fetch.mjs",
    "ds:specs": "node scripts/ds-snapshot/build-specs.mjs",
    "ds:preset-fixtures": "node scripts/preset-fixtures.mjs",
    "e2e:patterns-agent": "node e2e/patterns-agent.mjs",
    "e2e:ds-blocks": "node e2e/ds-blocks.mjs",
    "e2e:ds-blocks-insert": "node e2e/ds-blocks-insert.mjs",
    "e2e:ds-blocks-gallery": "node e2e/ds-blocks-gallery.mjs",
    "e2e:ds-fidelity": "node e2e/ds-fidelity.mjs",
    "e2e:ds-page": "node e2e/ds-page.mjs",
    "e2e:ds-registry": "node e2e/ds-registry.mjs",
    "e2e:ds-react-export": "node e2e/ds-react-export.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "motion": "14.10.1",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "input-otp": "1.5.0",
    "jsdom": "31.0.0",
    "lucide-react": "1.71.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
